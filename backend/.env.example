# Server
PORT=4000
NODE_ENV=development

# Database
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_password
DB_NAME=image_upload_db

# CDN / CloudFront URL — used as both CORS origin and image base URL
CDN_URL=https://your-cloudfront-domain.cloudfront.net

# AWS S3 (or S3-compatible service like MinIO)
AWS_ACCESS_KEY_ID=your_access_key_id
AWS_SECRET_ACCESS_KEY=your_secret_access_key
AWS_REGION=ap-south-1
AWS_S3_BUCKET=

# Optional: For S3-compatible services (MinIO, Localstack, etc.)
# AWS_ENDPOINT_URL=http://localhost:9000

# Storage Mode: 's3' or 'local' (local is fallback when S3 not configured)
STORAGE_MODE=local

# Validation Thresholds (optional — these are defaults)
# Set REQUIRE_FACE=true for profile-photo use cases (rejects images with no face)
# Set REQUIRE_FACE=false (default) to accept images without faces
REQUIRE_FACE=false
MIN_FILE_SIZE_BYTES=10240
MIN_DIMENSION_PX=200
BLUR_THRESHOLD=100
FACE_MIN_AREA_RATIO=0.05
SIMILARITY_HASH_DISTANCE=10
MAX_FILE_SIZE_BYTES=10485760

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
