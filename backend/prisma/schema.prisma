generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ImageStatus {
  PENDING
  PROCESSING
  ACCEPTED
  REJECTED
}

model Image {
  id               String      @id @default(uuid())
  originalName     String
  storedName       String      @unique
  mimeType         String
  sizeBytes        Int
  width            Int?
  height           Int?
  storageKey       String?
  storageUrl       String?
  thumbnailUrl     String?
  status           ImageStatus @default(PENDING)
  rejectionReasons String[]
  perceptualHash   String?
  processedAt      DateTime?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  @@index([status])
  @@index([createdAt])
  @@index([perceptualHash])
}
